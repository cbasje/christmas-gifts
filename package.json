{
	"name": "christmas-gifts",
	"author": "Sebastiaan Benjamins",
	"version": "3.0.0",
	"license": "GPL-3.0-only",
	"type": "module",
	"private": true,
	"scripts": {
		"dev": "vite dev --host",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"db:migrate": "drizzle-kit migrate",
		"db:generate": "drizzle-kit generate",
		"db:generate-zero": "drizzle-zero generate -f -o ./src/lib/zero/schema.gen.ts",
		"db:seed": "tsx scripts/seed.ts",
		"db:cache": "pnpm exec zero-cache-dev"
	},
	"dependencies": {
		"@neoconfetti/svelte": "^2.2.2",
		"@neondatabase/serverless": "^1.2.1",
		"drizzle-orm": "^0.45.4",
		"open-graph-scraper-lite": "^2.1.0"
	},
	"devDependencies": {
		"@inlang/paraglide-js": "^2.29.3",
		"@sveltejs/adapter-node": "^6.0.0",
		"@sveltejs/kit": "^3.0.0",
		"@sveltejs/vite-plugin-svelte": "^7.0.0",
		"drizzle-kit": "^0.31.11",
		"lightningcss": "^1.33.0",
		"open-props": "^1.7.23",
		"svelte": "^5.57.3",
		"svelte-check": "^4.7.8",
		"tsx": "^4.23.15",
		"typescript": "^6.0.3",
		"unplugin-icons": "^23.0.1",
		"vite": "^8.0.12",
		"ws": "^8.23.0",
		"zod": "^4.6.7"
	},
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*",
		"#components": "./src/lib/components/index.js",
		"#components/*": "./src/lib/components/*",
		"#db": "./src/lib/db/index.js",
		"#db/*": "./src/lib/db/*"
	}
}
