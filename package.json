{
	"name": "christmas-gifts",
	"author": "Sebastiaan Benjamins",
	"version": "3.0.0",
	"license": "GPL-3.0-only",
	"type": "module",
	"private": true,
	"scripts": {
		"dev": "vite dev --host",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check .",
		"format": "prettier --write .",
		"db:migrate": "drizzle-kit migrate",
		"db:generate": "drizzle-kit generate",
		"db:generate-zero": "drizzle-zero generate -f -o ./src/lib/zero/schema.gen.ts",
		"db:seed": "tsx scripts/seed.ts",
		"db:cache": "pnpm exec zero-cache-dev"
	},
	"dependencies": {
		"@neoconfetti/svelte": "^2.2.2",
		"@neondatabase/serverless": "^1.2.1",
		"drizzle-orm": "^0.45.4",
		"open-graph-scraper-lite": "^2.1.0"
	},
	"devDependencies": {
		"@inlang/paraglide-js": "^2.29.3",
		"@sveltejs/adapter-node": "^5.5.8",
		"@sveltejs/kit": "^2.70.4",
		"@sveltejs/vite-plugin-svelte": "^6.2.4",
		"drizzle-kit": "^0.31.11",
		"lightningcss": "^1.33.0",
		"open-props": "^1.7.23",
		"svelte": "^5.57.3",
		"svelte-check": "^4.7.8",
		"typescript": "^5.9.3",
		"unplugin-icons": "^23.0.1",
		"vite": "^7.3.8",
		"zod": "^4.6.7"
	}
}
